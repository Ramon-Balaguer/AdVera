# AdVera local configuration. Copy to backend/.env for local (non-Docker) runs.
# Keep these defaults identical to docker/compose.dev.yml.

DATABASE_URL=postgresql+asyncpg://advera:advera@localhost:5432/advera
REDIS_URL=redis://localhost:6379/0
AUDIO_STORAGE_PATH=./data/meetings

# Redis Streams (docs/redis.md)
TRANSCRIPTION_QUEUE_NAME=advera:transcription:jobs
SUMMARY_QUEUE_NAME=advera:summary:jobs
BRAIN_INDEX_QUEUE_NAME=advera:brain:index
BRAIN_QUERY_QUEUE_NAME=advera:brain:query

# ASR roles (spec §5). MOSS is opt-in and disabled by default (ADR 0007).
# There is deliberately no ASR language setting: providers autodetect (ADR 0014).
ASR_LIVE_PROVIDER=faster-whisper
ASR_DEFINITIVE_PROVIDER=faster-whisper
ASR_FALLBACK_PROVIDER=

# Local speaker diarization (ECAPA-VoxCeleb, spec §5). "none" disables speaker labels.
DIARIZATION_PROVIDER=local
DIARIZATION_MODEL=speechbrain/spkrec-ecapa-voxceleb
DIARIZATION_THRESHOLD=0.5

# LLM (Ollama) defaults. The Settings page stores the effective URL, model and output
# language in RUNTIME_SETTINGS_PATH, shared by the API and the workers (ADR 0009).
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=
# Optional bearer token for LLM servers behind authentication (stored by Settings in RUNTIME_SETTINGS_PATH, never returned by the API).
LLM_API_KEY=
LLM_OUTPUT_LANGUAGE=es
RUNTIME_SETTINGS_PATH=./data/config/settings.json
